// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model with NextAuth support
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String? // Hashed password for credentials auth
  name          String?
  image         String?
  emailVerified DateTime?
  preferences   Json? // UserPreferences JSON

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // App relations
  tasks        Task[]
  activityLogs ActivityLog[]
  userSubjects UserSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NextAuth Account model
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Verification token for email verification
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Subject model (DSA, OS, CN, etc.)
model Subject {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  icon        String? // Icon identifier or emoji
  order       Int     @default(0)
  isDefault   Boolean @default(false)

  topics       Topic[]
  userSubjects UserSubject[]

  createdAt DateTime @default(now())
}

// Topic model (sub-topics within a subject)
model Topic {
  id          String   @id @default(cuid())
  subjectId   String
  name        String
  description String?
  order       Int      @default(0)
  resources   String[] // Array of resource URLs

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([subjectId, name])
}

// User-Subject relationship with progress tracking
model UserSubject {
  id        String      @id @default(cuid())
  userId    String
  subjectId String
  status    TopicStatus @default(TODO)
  progress  Int         @default(0) // Percentage 0-100

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, subjectId])
}

// Task model for daily assignments
model Task {
  id            String      @id @default(cuid())
  userId        String
  date          DateTime    @db.Date
  type          TaskType
  title         String
  description   String?
  referenceLink String?
  platform      Platform?
  difficulty    Difficulty?
  tags          String[]
  status        TaskStatus  @default(PENDING)
  completedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

// Problem cache model (cached from LeetCode/Codeforces)
model Problem {
  id         String     @id @default(cuid())
  platform   Platform
  externalId String
  title      String
  difficulty Difficulty
  tags       String[]
  link       String
  acceptance Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, externalId])
}

// Activity log for tracking daily progress
model ActivityLog {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @db.Date
  tasksCompleted  Int      @default(0)
  problemsSolved  Int      @default(0)
  learningMinutes Int      @default(0)
  streak          Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// Enums
enum TopicStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskType {
  PROBLEM
  LEARNING
  REVIEW
}

enum TaskStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum Platform {
  LEETCODE
  CODEFORCES
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}
